+/* An Android host whose driver imports dma-bufs but exports no fd at all (Mali: AHardwareBuffer
+ * export only) has neither gbm nor udmabuf to allocate from. Gralloc does the allocation instead:
+ * a BLOB AHardwareBuffer is backed by a dma-buf, which the driver imports and the guest mmaps.
+ *
+ * AHardwareBuffer_getNativeHandle is not in the NDK stubs but libnativewindow exports it; it is
+ * looked up once at runtime. The dma-buf outlives the AHardwareBuffer, so only the fds are kept.
+ */
+struct vkr_native_handle {
+   int version;
+   int num_fds;
+   int num_ints;
+   int data[];
+};
+
+typedef const struct vkr_native_handle *(*vkr_get_native_handle_fn)(const AHardwareBuffer *);
+
+static vkr_get_native_handle_fn vkr_ahb_native_handle_fn;
+
+static void
+vkr_ahb_lookup_native_handle_fn(void)
+{
+   void *lib = dlopen("libnativewindow.so", RTLD_NOW | RTLD_LOCAL);
+   if (lib)
+      *(void **)&vkr_ahb_native_handle_fn = dlsym(lib, "AHardwareBuffer_getNativeHandle");
+   if (!vkr_ahb_native_handle_fn)
+      vkr_log("AHardwareBuffer_getNativeHandle unavailable: %s", dlerror());
+}
+
+static vkr_get_native_handle_fn
+vkr_ahb_get_native_handle_fn(void)
+{
+   static pthread_once_t once = PTHREAD_ONCE_INIT;
+   pthread_once(&once, vkr_ahb_lookup_native_handle_fn);
+   return vkr_ahb_native_handle_fn;
+}
+
+/* The guest maps these pages directly and never asks for cache maintenance (vtest's flush and
+ * invalidate do nothing, and gralloc's lock/unlock is never called). Cached gralloc usage is only
+ * asked for where the driver's own memory type is cached; for its coherent type the RARELY usage
+ * is a hint toward uncached pages, not a promise, so the heap gralloc actually chose is logged
+ * once per kind (vkr_ahb_log_heap). */
+static uint64_t
+vkr_ahb_cpu_usage(VkMemoryPropertyFlags property_flags)
+{
+   return (property_flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT)
+             ? AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN | AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN
+             : AHARDWAREBUFFER_USAGE_CPU_READ_RARELY | AHARDWAREBUFFER_USAGE_CPU_WRITE_RARELY;
+}
+
+/* The dma-buf exporter's name ("system", "system-uncached", ...) from fdinfo, once per CPU usage. */
+static void
+vkr_ahb_log_heap(int fd, uint64_t cpu_usage)
+{
+   static atomic_uint logged;
+   const unsigned bit = (cpu_usage & AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN) ==
+                              AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN
+                           ? 1u
+                           : 2u;
+   if (atomic_fetch_or(&logged, bit) & bit)
+      return;
+
+   char path[64], line[128], name[64] = "unknown";
+   snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+   FILE *f = fopen(path, "r");
+   if (f) {
+      while (fgets(line, sizeof(line), f)) {
+         if (sscanf(line, "exp_name: %63s", name) == 1)
+            break;
+      }
+      fclose(f);
+   }
+   vkr_log("gralloc memory for %s CPU access comes from dma-buf exporter \"%s\"",
+           bit == 1 ? "cached" : "uncached", name);
+}
+
+static VkResult
+vkr_ahb_get_fd_info_from_allocation_info(struct vkr_device *dev,
+                                         VkMemoryPropertyFlags property_flags,
+                                         const VkMemoryAllocateInfo *alloc_info,
+                                         int *out_keep_fd,
+                                         VkImportMemoryFdInfoKHR *out_fd_info)
+{
+   const vkr_get_native_handle_fn get_native_handle = vkr_ahb_get_native_handle_fn();
+   if (!get_native_handle)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   const uint64_t size = align64(alloc_info->allocationSize, getpagesize());
+   if (size > UINT32_MAX)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   const AHardwareBuffer_Desc desc = {
+      .width = (uint32_t)size,
+      .height = 1,
+      .layers = 1,
+      .format = AHARDWAREBUFFER_FORMAT_BLOB,
+      .usage = vkr_ahb_cpu_usage(property_flags) | AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER,
+   };
+   AHardwareBuffer *ahb = NULL;
+   int ret = AHardwareBuffer_allocate(&desc, &ahb);
+   if (ret) {
+      vkr_log("AHardwareBuffer_allocate(%u bytes) failed (%d)", desc.width, ret);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   const struct vkr_native_handle *handle = get_native_handle(ahb);
+   int fd = -1;
+   int keep_fd = -1;
+   if (handle && handle->num_fds >= 1) {
+      fd = os_dupfd_cloexec(handle->data[0]);
+      keep_fd = os_dupfd_cloexec(handle->data[0]);
+   }
+   AHardwareBuffer_release(ahb);
+   const off_t dma_buf_size = keep_fd >= 0 ? lseek(keep_fd, 0, SEEK_END) : -1;
+   if (fd < 0 || keep_fd < 0 || dma_buf_size < (off_t)alloc_info->allocationSize) {
+      vkr_log("AHardwareBuffer has no dma-buf fd of %" PRIu64 " bytes (%lld)",
+              (uint64_t)alloc_info->allocationSize, (long long)dma_buf_size);
+      if (fd >= 0)
+         close(fd);
+      if (keep_fd >= 0)
+         close(keep_fd);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   vkr_ahb_log_heap(keep_fd, desc.usage);
+
+   /* A type the driver will not import gralloc memory into fails here, cleanly, rather than as
+    * an invalid import (said once per type). */
+   static atomic_uint reported_types;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkMemoryFdPropertiesKHR fd_props = { .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR };
+   const uint32_t type_bit = alloc_info->memoryTypeIndex < 32 ? 1u << alloc_info->memoryTypeIndex : 0;
+   if (vk->GetMemoryFdPropertiesKHR(dev->base.handle.device,
+                                    VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, keep_fd,
+                                    &fd_props) != VK_SUCCESS ||
+       !(fd_props.memoryTypeBits & type_bit)) {
+      if (!(atomic_fetch_or(&reported_types, type_bit) & type_bit))
+         vkr_log("memory type %u cannot hold a gralloc dma-buf (the driver allows 0x%x)",
+                 alloc_info->memoryTypeIndex, fd_props.memoryTypeBits);
+      close(fd);
+      close(keep_fd);
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+
+   *out_keep_fd = keep_fd;
+   *out_fd_info = (VkImportMemoryFdInfoKHR){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = alloc_info->pNext,
+      .fd = fd,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   return VK_SUCCESS;
+}
+#endif /* __ANDROID__ */
